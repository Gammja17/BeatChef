    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uBC29\uD5A5\uD0A4 / WASD \uB610\uB294 \uB9C8\uC6B0\uC2A4 \uC2A4\uC640\uC774\uD504\uB85C
    \uC7AC\uB8CC\uB97C \uC370\uC5B4\uC694\n\n\uB9C1\uC774 \uC870\uC5EC\uB4E4\uB2E4
    \uD654\uC0B4\uD45C\uC5D0 \uB531 \uACB9\uCE58\uB294 \uC21C\uAC04\uC774 \uC815\uB2F5
    \uD0C0\uC774\uBC0D!\n\uD310\uC815\uC740 PERFECT \xB7 GOOD \xB7 MISS\n\n\uD074\uB798\uC2DD
    \uBAA8\uB4DC: \uD654\uBA74 \uACF3\uACF3\uC5D0 \uD654\uC0B4\uD45C\uAC00 \uB5A0\uC694\n\uC774\uC9C0
    \uBAA8\uB4DC: 4\uBC29\uD5A5 \uACE0\uC815 \uC704\uCE58\uB85C \uB0A0\uC544\uC640
    \uC77D\uAE30 \uC26C\uC6CC\uC694\n\n<color=#FFD84D>20\uCF64\uBCF4</color>\uB97C
    \uB118\uAE30\uBA74 \uD53C\uBC84 \uD0C0\uC784 \u2014 \uC810\uC218 \uBC30\uC728
    UP! (MISS\uD558\uBA74 \uD574\uC81C)\n\nESC \uC77C\uC2DC\uC815\uC9C0 \xB7 F1 /
    F2 \uD310\uC815 \uD0C0\uC774\uBC0D \uBCF4\uC815"
